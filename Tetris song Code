# This is Tetris Theme

// Tetris theme (Korobeiniki), full version
// Buzzer + to pin 8, buzzer - to GND

#define BUZZER_PIN 8

#define NOTE_GS4 415
#define NOTE_A4  440
#define NOTE_B4  494
#define NOTE_C5  523
#define NOTE_D5  587
#define NOTE_E5  659
#define NOTE_F5  698
#define NOTE_G5  784
#define NOTE_GS5 831
#define NOTE_A5  880
#define REST     0

int tempo = 144;

// 4 = quarter, 8 = eighth, 2 = half, negative = dotted
int melody[] = {
  // Section A
  NOTE_E5, 4,  NOTE_B4, 8,  NOTE_C5, 8,  NOTE_D5, 4,  NOTE_C5, 8,  NOTE_B4, 8,
  NOTE_A4, 4,  NOTE_A4, 8,  NOTE_C5, 8,  NOTE_E5, 4,  NOTE_D5, 8,  NOTE_C5, 8,
  NOTE_B4, -4, NOTE_C5, 8,  NOTE_D5, 4,  NOTE_E5, 4,
  NOTE_C5, 4,  NOTE_A4, 4,  NOTE_A4, 8,  NOTE_A4, 4,  NOTE_B4, 8,  NOTE_C5, 8,

  // Section B
  NOTE_D5, -4, NOTE_F5, 8,  NOTE_A5, 4,  NOTE_G5, 8,  NOTE_F5, 8,
  NOTE_E5, -4, NOTE_C5, 8,  NOTE_E5, 4,  NOTE_D5, 8,  NOTE_C5, 8,
  NOTE_B4, 4,  NOTE_B4, 8,  NOTE_C5, 8,  NOTE_D5, 4,  NOTE_E5, 4,
  NOTE_C5, 4,  NOTE_A4, 4,  NOTE_A4, 4,  REST, 4,

  // Section C (slow held notes)
  NOTE_E5, 2,  NOTE_C5, 2,
  NOTE_D5, 2,  NOTE_B4, 2,
  NOTE_C5, 2,  NOTE_A4, 2,
  NOTE_GS4, 2, NOTE_B4, 4,  REST, 8,
  NOTE_E5, 2,  NOTE_C5, 2,
  NOTE_D5, 2,  NOTE_B4, 2,
  NOTE_C5, 4,  NOTE_E5, 4,  NOTE_A5, 2,
  NOTE_GS5, 2
};

int notes = sizeof(melody) / sizeof(melody[0]) / 2;
int wholenote = (60000 * 4) / tempo;

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
}

void loop() {
  for (int i = 0; i < notes * 2; i += 2) {
    int divider = melody[i + 1];
    int noteDuration;

    if (divider > 0) {
      noteDuration = wholenote / divider;
    } else {
      noteDuration = (wholenote / abs(divider)) * 1.5;  // dotted
    }

    if (melody[i] != REST) {
      tone(BUZZER_PIN, melody[i], noteDuration * 0.9);
    }
    delay(noteDuration);
    noTone(BUZZER_PIN);
  }

  delay(2000);  // pause before looping
}


Make sure buzzer is connected to Pin 8
