// Super Mario Bros. overworld theme
// Buzzer + to pin 8, buzzer - to GND

#define BUZZER_PIN 8

#define NOTE_E4  330
#define NOTE_G4  392
#define NOTE_GS4 415
#define NOTE_A4  440
#define NOTE_AS4 466
#define NOTE_B4  494
#define NOTE_C5  523
#define NOTE_D5  587
#define NOTE_DS5 622
#define NOTE_E5  659
#define NOTE_F5  698
#define NOTE_FS5 740
#define NOTE_G5  784
#define NOTE_A5  880
#define NOTE_C6  1047
#define REST     0

int tempo = 200;

// 4 = quarter, 8 = eighth, 2 = half, negative = dotted
int melody[] = {
  // Intro
  NOTE_E5, 8,  NOTE_E5, 8,  REST, 8,  NOTE_E5, 8,  REST, 8,  NOTE_C5, 8,  NOTE_E5, 8,  REST, 8,
  NOTE_G5, 4,  REST, 4,     NOTE_G4, 4,  REST, 4,

  // Main theme
  NOTE_C5, -4, NOTE_G4, 8,  REST, 4,  NOTE_E4, -4,
  NOTE_A4, 4,  NOTE_B4, 4,  NOTE_AS4, 8,  NOTE_A4, 4,
  NOTE_G4, 8,  NOTE_E5, 8,  NOTE_G5, 8,  NOTE_A5, 4,  NOTE_F5, 8,  NOTE_G5, 8,
  REST, 8,     NOTE_E5, 4,  NOTE_C5, 8,  NOTE_D5, 8,  NOTE_B4, -4,

  // Main theme (repeat)
  NOTE_C5, -4, NOTE_G4, 8,  REST, 4,  NOTE_E4, -4,
  NOTE_A4, 4,  NOTE_B4, 4,  NOTE_AS4, 8,  NOTE_A4, 4,
  NOTE_G4, 8,  NOTE_E5, 8,  NOTE_G5, 8,  NOTE_A5, 4,  NOTE_F5, 8,  NOTE_G5, 8,
  REST, 8,     NOTE_E5, 4,  NOTE_C5, 8,  NOTE_D5, 8,  NOTE_B4, -4,

  // Bridge 1
  REST, 4,     NOTE_G5, 8,  NOTE_FS5, 8, NOTE_F5, 8,  NOTE_DS5, 4,  NOTE_E5, 8,
  REST, 8,     NOTE_GS4, 8, NOTE_A4, 8,  NOTE_C5, 8,  REST, 8,      NOTE_A4, 8,  NOTE_C5, 8,  NOTE_D5, 8,
  REST, 4,     NOTE_G5, 8,  NOTE_FS5, 8, NOTE_F5, 8,  NOTE_DS5, 4,  NOTE_E5, 8,
  REST, 8,     NOTE_C6, 4,  NOTE_C6, 8,  NOTE_C6, 4,  REST, 2,

  // Bridge 2
  REST, 4,     NOTE_G5, 8,  NOTE_FS5, 8, NOTE_F5, 8,  NOTE_DS5, 4,  NOTE_E5, 8,
  REST, 8,     NOTE_GS4, 8, NOTE_A4, 8,  NOTE_C5, 8,  REST, 8,      NOTE_A4, 8,  NOTE_C5, 8,  NOTE_D5, 8,
  REST, 4,     NOTE_DS5, 4, REST, 8,     NOTE_D5, -4, NOTE_C5, 2,   REST, 2
};

int notes = sizeof(melody) / sizeof(melody[0]) / 2;
int wholenote = (60000 * 4) / tempo;

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
}

void loop() {
  for (int i = 0; i < notes * 2; i += 2) {
    int divider = melody[i + 1];
    int noteDuration;

    if (divider > 0) {
      noteDuration = wholenote / divider;
    } else {
      noteDuration = (wholenote / abs(divider)) * 1.5;  // dotted
    }

    if (melody[i] != REST) {
      tone(BUZZER_PIN, melody[i], noteDuration * 0.9);
    }
    delay(noteDuration);
    noTone(BUZZER_PIN);
  }

  delay(2000);  // pause before looping
}
